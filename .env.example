# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SECRET_KEY=your_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Google Apps Script Web App Deployment URL
GAS_WEB_APP_ID=your_deployment_id
GAS_WEB_APP_URL=https://script.google.com/macros/s/your_deployment_id/exec
